{
  "name": "@bugg-m/bugg-ui",
  "version": "2.1.2",
  "publishConfig": {
    "access": "public"
  },
  "description": "A design system built with Vite, React, TypeScript, Tailwind, and Storybook",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "dist/bugg-ui-umd.cjs",
  "module": "dist/bugg-ui.js",
  "types": "dist/bugg-ui.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bugg-m/bugg-ui.git"
  },
  "exports": {
    ".": {
      "import": "./dist/bugg-ui.js",
      "require": "./dist/bugg-ui-umd.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "prebuild": "rm -rf dist",
    "build": "tsc --project tsconfig.json && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build-all": "yarn build && yarn build-storybook"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.424.0",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^1.6.1",
    "@storybook/addon-essentials": "^8.2.3",
    "@storybook/addon-interactions": "^8.2.3",
    "@storybook/addon-links": "^8.2.3",
    "@storybook/addon-onboarding": "^8.2.3",
    "@storybook/addon-themes": "^8.2.3",
    "@storybook/blocks": "^8.2.3",
    "@storybook/react": "^8.2.3",
    "@storybook/react-vite": "^8.2.3",
    "@storybook/test": "^8.2.3",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.13",
    "@types/node": "^22.10.7",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "eslint-plugin-storybook": "^0.8.0",
    "postcss": "^8.4.38",
    "prettier": "^3.3.2",
    "storybook": "^8.2.3",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.2.2",
    "vite": "^5.2.0",
    "vite-plugin-dts": "^3.9.1",
    "vite-tsconfig-paths": "^4.3.2"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "keywords": [
    "design system",
    "react",
    "vite",
    "storybook",
    "typescript",
    "tailwind",
    "ui library"
  ],
  "author": "Bugg",
  "license": "MIT"
}
