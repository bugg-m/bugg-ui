{
  "name": "@bugg-m/bugg-ui",
  "version": "2.3.5",
  "publishConfig": {
    "access": "public"
  },
  "description": "A design system built with Vite, React, TypeScript, Tailwind, and Storybook",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "dist/bugg-ui-umd.cjs",
  "module": "dist/bugg-ui.js",
  "types": "dist/bugg-ui.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bugg-m/bugg-ui.git"
  },
  "exports": {
    ".": {
      "types": "./dist/bugg-ui.d.ts",
      "require": "./dist/bugg-ui-umd.cjs",
      "import": "./dist/bugg-ui.js",
      "default": "./dist/bugg-ui.js"
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "prebuild": "rm -rf dist",
    "build": "tsc --project tsconfig.json && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build-all": "yarn build && yarn build-storybook",
    "prepublishOnly": "yarn build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "react-inlinesvg": "^4.2.0",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^3.2.4",
    "@storybook/addon-essentials": "^8.5.5",
    "@storybook/addon-interactions": "^8.5.5",
    "@storybook/addon-links": "^8.5.5",
    "@storybook/addon-onboarding": "^8.5.5",
    "@storybook/addon-themes": "^8.5.5",
    "@storybook/blocks": "^8.5.5",
    "@storybook/manager-api": "^8.5.5",
    "@storybook/react": "^8.5.5",
    "@storybook/react-vite": "^8.5.5",
    "@storybook/test": "^8.5.5",
    "@storybook/theming": "^8.5.5",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.13",
    "@types/node": "^22.10.7",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "eslint-plugin-storybook": "^0.11.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "postcss": "^8.4.38",
    "prettier": "^3.3.2",
    "storybook": "^8.5.5",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.2.2",
    "vite": "^5.2.0",
    "vite-plugin-dts": "^3.9.1",
    "vite-tsconfig-paths": "^4.3.2"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "keywords": [
    "design system",
    "react",
    "vite",
    "storybook",
    "typescript",
    "tailwind",
    "ui library"
  ],
  "author": "Bugg",
  "license": "MIT"
}
